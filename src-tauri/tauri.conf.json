{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "T-Reader",
  "version": "0.3.2",
  "identifier": "com.t-reader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5151",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "书架",
        "width": 880,
        "height": 660,
        "decorations": false,
        "minWidth": 880,
        "minHeight": 660
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/reader.png",
      "icons/reader.ico"
    ]
  }
}
