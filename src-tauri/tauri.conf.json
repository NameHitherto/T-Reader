{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "T-Reader",
  "version": "1.0.4",
  "identifier": "com.t-reader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "书架",
        "width": 880,
        "height": 660,
        "decorations": false,
        "minWidth": 880,
        "minHeight": 660
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": "v1Compatible",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/reader.png",
      "icons/reader.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/NameHitherto/T-Reader/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDQzNEQzg0OENENzhBMDgKUldRSWl0ZU1oTnpEZktMVEd4Q2ZCWTkvcm5BZnB6V3lmbHlQWWhDV0RGZUl2QXROTnNyS3Q5UWoK"
    }
  }
}
