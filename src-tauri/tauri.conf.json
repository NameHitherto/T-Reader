{
  "$schema": "https://schema.tauri.app/config/2.0.0-rc",
  "productName": "t2-reader",
  "version": "0.1.0",
  "identifier": "com.t2-reader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "t-reader",
        "width": 800,
        "height": 600,
        "decorations": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/Roxy.png",
      "icons/Roxy.ico",
      "icons/Roxy.icns"
    ]
  }
}
